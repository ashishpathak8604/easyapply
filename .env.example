# Copy this file to .env and fill in only the providers/sources you actually use.
# .env is ignored by git and must never be committed.

# AI providers (optional in Phase 1; no provider is called by default)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# Adzuna job API (optional; only needed if the Adzuna collector is enabled)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
